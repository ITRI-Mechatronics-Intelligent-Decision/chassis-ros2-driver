<?xml version="1.0" encoding="utf-8"?>
<!--
  TD-S — 差速式履帶底盤（Tracked Differential, Small）。

  履帶本身包在 base_link.STL 裡（機構匯出時已含履帶外形，見 CAD 量測），
  因此本檔只放四顆輪子（前 = 主動輪、後 = 惰輪），不對履帶本身建 joint —
  履帶的形變與捲繞不具建模意義，這是履帶車 URDF 的標準做法。

  惰輪雖不受馬達直驅，但由履帶帶動旋轉，因此仍設為 continuous 並會收到
  joint_states（角速度依前後輪半徑比換算，見 chassis_driver 的
  *_wheel_joint_ratios 參數，非本檔案職責）。

  IMU（矽林 CH104）隨底盤出貨，因此包含於此。
  頭部支架（head_link）與相機（D435_link）屬於部門二次開發的掛載物，
  刻意不放在這裡 —— 依 CAD 量測會跟著出貨的裸底盤只到輪子與 IMU 為止，
  感測器／致動器由下游 devkit 專案疊加，見協作討論紀錄。
-->
<robot name="chassis" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="chassis_common.xacro" />

  <!-- ═══════════════════════════════════════════
       Chassis geometry parameters
  ══════════════════════════════════════════════ -->
  <xacro:property name="mesh_dir"  value="TD-S"     />  <!-- meshes/<mesh_dir>/ -->
  <xacro:property name="front_x"   value="0.135"    />  <!-- 主動輪（前）x（m） -->
  <xacro:property name="rear_x"    value="-0.155"   />  <!-- 惰輪（後）x（m） -->
  <xacro:property name="track_y"   value="0.22"     />  <!-- 左右輪心 y（m） -->
  <xacro:property name="front_wheel_z" value="0.1125" />  <!-- 主動輪軸心高度（m） -->
  <xacro:property name="rear_wheel_z"  value="0.08"    />  <!-- 惰輪軸心高度（m） -->

  <!-- 接地面偏移：履帶車接地的是履帶下緣而非輪緣，不可套用
       wheel_radius - wheel_z 這個輪式底盤才成立的算法。
       由 base_link.STL 最低點量得（見 CAD 量測紀錄）。 -->
  <xacro:property name="ground_offset" value="0.0017" />

  <!-- 輪組慣性（來自 SolidWorks 匯出，ixx == izz 為軸對稱輪） -->
  <xacro:property name="front_wheel_mass" value="0.5142"    />
  <xacro:property name="front_wheel_ixx"  value="0.0010491" />
  <xacro:property name="front_wheel_iyy"  value="0.0020403" />

  <xacro:property name="rear_wheel_mass"  value="0.23531"   />
  <xacro:property name="rear_wheel_ixx"   value="0.00021097" />
  <xacro:property name="rear_wheel_iyy"   value="0.00037406" />

  <!-- ═══════════════════════════════════════════
       Base footprint link
  ══════════════════════════════════════════════ -->
  <xacro:base_footprint ground_offset="${ground_offset}" />

  <!-- ═══════════════════════════════════════════
       Base link（含履帶外形）
  ══════════════════════════════════════════════ -->
  <link name="base_link">
    <inertial>
      <origin xyz="0.019935 0.015273 0.1715" rpy="0 0 0" />
      <mass value="8.8745" />
      <inertia
        ixx="0.1278"   ixy="0.00032713" ixz="-0.0068375"
        iyy="0.16689"  iyz="0.0005609"
        izz="0.20483" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://chassis_description/meshes/${mesh_dir}/base_link.STL" />
      </geometry>
      <material name="white">
        <color rgba="1 1 1 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://chassis_description/meshes/${mesh_dir}/base_link.STL" />
      </geometry>
    </collision>
  </link>

  <!-- ═══════════════════════════════════════════
       Wheel instances
       axis_y 依 chassis_common.xacro 慣例（左 +1、右 -1）指定，
       不沿用 CAD 匯出值 —— 原始匯出的後輪 axis 左右不一致且有一筆為
       0 0 0（無效值），已在整合時修正。
  ══════════════════════════════════════════════ -->
  <xacro:wheel mesh_dir="${mesh_dir}" name="front_left"
               x="${front_x}"  y="${track_y}"   z="${front_wheel_z}"  axis_y="1"
               mass="${front_wheel_mass}" ixx="${front_wheel_ixx}" iyy="${front_wheel_iyy}"
               com_y="-0.00048081"
               color="0.50196 0.50196 0.50196" />

  <xacro:wheel mesh_dir="${mesh_dir}" name="front_right"
               x="${front_x}"  y="${-track_y}"  z="${front_wheel_z}"  axis_y="-1"
               mass="${front_wheel_mass}" ixx="${front_wheel_ixx}" iyy="${front_wheel_iyy}"
               com_y="0.00048081"
               color="0.50196 0.50196 0.50196" />

  <xacro:wheel mesh_dir="${mesh_dir}" name="rear_left"
               x="${rear_x}"   y="${track_y}"   z="${rear_wheel_z}"  axis_y="1"
               mass="${rear_wheel_mass}"  ixx="${rear_wheel_ixx}"  iyy="${rear_wheel_iyy}"
               com_y="-0.00077635"
               color="0.75294 0.75294 0.75294" />

  <xacro:wheel mesh_dir="${mesh_dir}" name="rear_right"
               x="${rear_x}"   y="${-track_y}"  z="${rear_wheel_z}"  axis_y="-1"
               mass="${rear_wheel_mass}"  ixx="${rear_wheel_ixx}"  iyy="${rear_wheel_iyy}"
               com_y="0.00077635"
               color="0.75294 0.75294 0.75294" />

  <!-- ═══════════════════════════════════════════
       IMU（矽林 CH104）
  ══════════════════════════════════════════════ -->
  <link name="imu_link">
    <inertial>
      <origin xyz="0.0 0.00049093 -0.0028775" rpy="0 0 0" />
      <mass value="0.015203" />
      <inertia
        ixx="3.4532E-06" ixy="0.0"        ixz="0.0"
        iyy="3.5859E-06" iyz="1.6004E-09"
        izz="5.6462E-06" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://chassis_description/meshes/${mesh_dir}/imu_link.STL" />
      </geometry>
      <material name="imu_color">
        <color rgba="1 1 1 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://chassis_description/meshes/${mesh_dir}/imu_link.STL" />
      </geometry>
    </collision>
  </link>

  <joint name="imu_joint" type="fixed">
    <origin xyz="-0.0645 0 0.2995" rpy="0 0 0" />
    <parent link="base_link" />
    <child  link="imu_link" />
  </joint>

</robot>
